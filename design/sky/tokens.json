{
  "$comment": "MusicScan Sky design tokens. Same values as :root in web/style.css. Text pairs meet WCAG AA 4.5:1.",
  "color": {
    "sky25":    { "value": "#F5FAFF", "use": "app background" },
    "sky50":    { "value": "#EAF4FE", "use": "top bars, wells, hover" },
    "sky100":   { "value": "#D8EAFC", "use": "selected / pressed fill (text blue700 on it, 5.94:1)" },
    "sky200":   { "value": "#B9D9F7", "use": "staff-line motif, art" },
    "sky400":   { "value": "#5FAEEB", "use": "illustration only, never text" },
    "blue600":  { "value": "#1769C2", "use": "primary buttons, accent (white text 5.47:1)" },
    "blue700":  { "value": "#0F56A3", "use": "accent text, links, selected labels" },
    "navy900":  { "value": "#0E2238", "use": "text, notation; also the dark practice bar surface" },
    "slate600": { "value": "#4E647C", "use": "secondary text" },
    "panel":    { "value": "#FFFFFF", "use": "cards, score page, sheets" },
    "line":     { "value": "#D6E4F2", "use": "dividers, card borders" },
    "line2":    { "value": "#C9DDF1", "use": "control borders" },
    "marigold": { "value": "#F6B93B", "use": "Pro badge and celebrations only" }
  },
  "flag": {
    "sure":   { "ink": "#1D7A4E", "fill": "#E2F5EA", "shape": "check" },
    "glance": { "ink": "#8A5300", "fill": "#FFF1D6", "stroke": "#E39B1B", "shape": "dot" },
    "wrong":  { "ink": "#C2362B", "fill": "#FDE8E6", "shape": "triangle" }
  },
  "font": {
    "display": "ui-rounded, 'SF Pro Rounded', Nunito, system-ui, sans-serif",
    "ui": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "weights": { "display": 900, "title": 800, "label": 600, "body": 400 }
  },
  "radius": { "control": 10, "button": 14, "card": 20, "sheet": 28, "pill": 99 },
  "size": { "minTarget": 44, "primaryButton": 52, "iconStroke": 1.75 },
  "space": [4, 8, 12, 16, 20, 24, 28, 32],
  "shadow": { "card": "0 1px 2px rgba(14,34,56,.06), 0 8px 28px rgba(23,105,194,.10)", "sheet": "0 30px 80px rgba(14,34,56,.35)" },
  "scrim": "rgba(14,34,56,.5)"
}
