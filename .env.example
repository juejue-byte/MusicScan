# Copy to .env (gitignored) or run:  scripts/use_server.sh <server address> <access key>
# Your hosted reader and its access key (the same key you gave `modal secret create musicscan ...`).
MUSICSCAN_SERVER_URL=https://YOURNAME--musicscan.us-east.modal.run
MUSICSCAN_ACCESS_KEY=

# Supabase (sign-in, page counts). The secret key is for the server only (modal secret), never the app.
SUPABASE_URL=https://fliegieshsoywgrjyltw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# StoreKit server verification (private server settings). APPLE_APP_ID is the numeric App Store ID, required in production.
APPLE_BUNDLE_ID=com.example.musicscan
APPLE_APP_ID=
